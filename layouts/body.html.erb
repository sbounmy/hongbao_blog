<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset='utf-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= current_page.data.fetch("title") %></title>

    <%# SEO Meta Tags %>
    <% if current_page.data["description"] %>
      <meta name="description" content="<%= current_page.data["description"] %>">
    <% end %>
    <link rel="canonical" href="<%= request.original_url rescue "https://hongbaob.tc#{current_page.request_path}" %>">

    <%# Open Graph Tags %>
    <meta property="og:type" content="<%= current_page.data["layout"] == "post" ? "article" : "website" %>">
    <meta property="og:title" content="<%= current_page.data["title"] %>">
    <% if current_page.data["description"] %>
      <meta property="og:description" content="<%= current_page.data["description"] %>">
    <% end %>
    <meta property="og:url" content="<%= request.original_url rescue "https://hongbaob.tc#{current_page.request_path}" %>">
    <% if current_page.data["image"] %>
      <meta property="og:image" content="<%= current_page.data["image"] %>">
    <% end %>
    <meta property="og:site_name" content="HongBao">

    <%# Twitter Card Tags %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= current_page.data["title"] %>">
    <% if current_page.data["description"] %>
      <meta name="twitter:description" content="<%= current_page.data["description"] %>">
    <% end %>
    <% if current_page.data["image"] %>
      <meta name="twitter:image" content="<%= current_page.data["image"] %>">
    <% end %>

    <%= stylesheet_link_tag "site" %>
    <%= javascript_include_tag "sitepress", "data-turbo-track": "reload", type: "module" %>

    <%= render_if_exists "shared/plausible" %>

  </head>
  <body class="bg-base-100 text-base-content">
    <%= render_if_exists "shared/header" %>
    <div class='mt-20'>
      <%= yield %>
    </div>
    <%= render_if_exists "shared/footer" %>
  </body>
</html>